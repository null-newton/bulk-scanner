{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bulk Scanner",
  "version": "../package.json",
  "identifier": "com.zacsvae.bulkscanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bulk Scanner",
        "width": 1320,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#071013"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Scan batches of documents into named PDFs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwRDlGN0MyQUM1MDY2NDkKUldSSlpsQ3N3dmZaOElSUk84VXhNL3FuanNEdHoxakV6M21JRTNxNDNoYXVuWmdEWTFMTy80MVkK",
      "endpoints": [
        "https://github.com/null-newton/bulk-scanner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
